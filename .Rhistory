library(pacman)
p_load(bookdown,
ggforce,
ggplot2,
readr,
readxl
)
data <- read_excel("input/data/ISSP2015_Data.xlsx")
data <- data %>%
select(c_alphan, name = Name , union_power = `Union power`, job_control = `Job control` )
View(data)
# Crear el gráfico
ggplot(data, aes(x = job_control, y = union_power)) +
geom_point(size = 3) +
geom_smooth(method = "lm", se = FALSE, color = "blue", linewidth = 0.6) +  # línea de tendencia
geom_text(aes(label = name), vjust = -1.1, size = 3) +  # etiquetas con los países
geom_point(data = subset(data, name == "Chile"), color = "red", size = 4) +  # destacar Chile
geom_circle(data = subset(data, name == "Chile"),
aes(x0 = job_control, y0 = union_power, r = 3),
inherit.aes = FALSE,
color = "red", linewidth = 1) +
theme_minimal() +
labs(
x = "Control del trabajo",
y = "Poder sindical",
title = "Relación entre poder sindical y control del trabajo"
)
